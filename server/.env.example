# Database (same PostgreSQL as Next.js/Prisma)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qrev

# Encryption key for stored provider credentials
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CREDENTIALS_ENCRYPTION_KEY=

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Telegram Bot (optional — leave empty to disable)
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Set the bot username (without @)
# 3. For production: set webhook URL to your public server
# 4. Generate a random secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
