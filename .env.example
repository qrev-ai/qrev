# QRev Environment Variables
# Copy this to .env and fill in your values

# Required: Google OAuth (for login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Required: OpenAI API Key (for AI features)
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: JWT Secrets (auto-generated if not set, but set for production)
REFRESH_TOKEN_JWT_SECRET=your-refresh-secret-here
ACCESS_TOKEN_JWT_SECRET=your-access-secret-here

# Optional: AI Server Token (for internal auth)
AI_BOT_SERVER_TOKEN=qrev-dev-token

# Optional: Email Verification
MILLIONVERIFIER_API_KEY=your-millionverifier-key

# Optional: LinkedIn Enrichment
NUBELA_API_KEY=your-nubela-key
PDL_API_KEY=your-pdl-key
