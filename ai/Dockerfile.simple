# QRev AI Server - Simplified Dockerfile
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get -y install --no-install-recommends build-essential curl git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    pip install --no-cache-dir --upgrade pip setuptools wheel poetry gunicorn flask

# Copy all project files
COPY . .

# Install dependencies (skip lock file if missing)
RUN poetry install --no-root --no-interaction 2>/dev/null || \
    (cd projects/server && poetry install --no-interaction 2>/dev/null) || \
    pip install flask gunicorn openai llama-index chromadb pydantic

# Create config directory
RUN mkdir -p /root/.config/qai

WORKDIR /app/projects/server

EXPOSE 8081

# Start server with simple flask
CMD ["sh", "-c", "python -c 'from qai.server.serve import app; app.run(host=\"0.0.0.0\", port=8081)' || python -m flask run --host=0.0.0.0 --port=8081"]
